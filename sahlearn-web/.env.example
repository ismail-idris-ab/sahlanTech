# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Google Analytics measurement ID (optional — leave blank to disable)
VITE_GA_ID=

# Bank transfer details shown on the public enrollment page
VITE_BANK_NAME=Your Bank Name
VITE_BANK_ACCOUNT=0000000000
VITE_BANK_ACCOUNT_NAME=Your Account Name

# WhatsApp number (digits only, e.g. 2348012345678)
VITE_WHATSAPP_NUMBER=2348012345678

# Public site URL (used for canonical/SEO tags)
VITE_SITE_URL=https://sahlearn.com

# Social links (shown in footer/contact)
VITE_FACEBOOK_URL=https://facebook.com/sahlearn
VITE_LINKEDIN_URL=https://linkedin.com/company/sahlearn
VITE_TWITTER_URL=https://twitter.com/sahlearn
VITE_YOUTUBE_URL=https://youtube.com/@sahlearn
VITE_INSTAGRAM_URL=https://instagram.com/sahlearn
VITE_GITHUB_URL=https://github.com/sahlearn
