# Node environment: development | production
NODE_ENV=development
# Port the API listens on
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sahlearn

# JWT signing secret — use a random 32+ character string
JWT_SECRET=change-this-to-a-random-32-char-string
# JWT token lifetime
JWT_EXPIRES_IN=7d

# Cloudinary credentials (image/file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# First-run admin account (change password after first login)
ADMIN_SEED_EMAIL=admin@sahlearn.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# Email — Gmail SMTP (use a Gmail App Password, not the account password)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Display name + from address for outgoing mail
MAIL_FROM=Sahlearn <youraddress@gmail.com>

# WhatsApp Business number (digits only, e.g. 2348012345678) — admin click-to-send link
WA_BUSINESS_NUMBER=2348012345678

# Bank transfer details (shown in enrollment emails)
BANK_NAME=Your Bank Name
BANK_ACCOUNT=0000000000
BANK_ACCOUNT_NAME=Your Account Name
